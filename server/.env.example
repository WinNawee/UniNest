# Copy this file to ".env" (in the same server folder) and fill in your values.
# Never commit .env to GitHub. It is already in .gitignore.

# ---------- Database (MongoDB Atlas) ----------
# Leave empty to use in-memory data (lost when the server stops).
# Atlas > your cluster > Connect > Drivers. Replace <db_password> with your real password.
MONGODB_URI=

# Optional: run "npm test" against Atlas too. The database name must contain "test".
# MONGODB_TEST_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/uninest_test

# ---------- Email (confirmation and password reset links) ----------
# Leave empty and the link is printed in the server terminal instead.
# On your laptop, Gmail works: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below (no spaces).
# On Render's free plan Gmail is blocked, so use Brevo instead (see DEPLOY.md):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=2525
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UniNest <your.address@gmail.com>

# Where the link in the email should open (the web app).
# Not needed on Render: it uses the Render address automatically.
APP_URL=http://localhost:5173

# ---------- Security ----------
# Any long random text (at least 32 characters). Change it before putting the app online.
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Live site only ----------
# Set NODE_ENV=production on the live site. Then:
#   - the server will not start without JWT_SECRET and ADMIN_PASSWORD
#   - admin@uninest.example uses ADMIN_PASSWORD instead of the public demo password
#   - demo students and the demo landlord cannot log in and are hidden from matches
#   - demo rooms are shown as "Sample listing"
# NODE_ENV=production
# ADMIN_PASSWORD=choose-a-private-password
# Set to "on" to allow demo accounts on the live site anyway (for example on presentation day).
# DEMO_ACCOUNTS=on

# ---------- Premium payment (PromptPay) ----------
# Your PromptPay number: a 10-digit phone number or 13-digit ID. Leave empty to
# show a TEST QR that should not be paid. Real money goes to this number.
PROMPTPAY_ID=
PROMPTPAY_NAME=UniNest
PREMIUM_PRICE=199
# Price landlords pay to feature a room for 30 days
FEATURED_PRICE=99
